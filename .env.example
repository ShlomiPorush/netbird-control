# Server port (exposed to host)
PORT=3000

# Production image tag pulled from GHCR (ghcr.io/shlomiporush/nbcontrol).
# Pin a released version (e.g. 0.0.8) or leave as "latest". Dev ignores this.
TAG=latest

# PostgreSQL connection
DB_HOST=db
DB_PORT=5432
DB_NAME=netbird_logs
DB_USER=netbird
DB_PASSWORD=change-me-to-a-strong-password

# Optional: Bearer token to authenticate incoming webhooks from NetBird.
# If empty here, an admin can set/rotate it in the app (Settings → Webhook).
# Setting it here locks the field in the UI (env always wins). Empty everywhere = no auth.
WEBHOOK_AUTH_TOKEN=

# Optional: Telegram bot token for notifications (from @BotFather). MAIN ACCOUNT ONLY - managed
# MSP tenants set their own bot token in the app (settings-only, never from env). If empty here, an
# admin can set it in the app (Settings → Telegram). Setting it here locks the main field in the UI.
# The chat ID, per-category topics and event selection are managed in the app, not here.
TELEGRAM_BOT_TOKEN=

# Optional: SMTP email, so users are notified when their access is approved / denied / ends.
# If SMTP_HOST is set here, the WHOLE email config comes from these vars and the in-app form
# (Settings → Email (SMTP)) is read-only. Leave SMTP_HOST empty to configure it in the app instead.
# SMTP_SECURE=true → implicit TLS (port 465); false/empty → STARTTLS (port 587). SMTP_FROM
# defaults to SMTP_USER. SMTP_USER/SMTP_PASS may be empty for an unauthenticated relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Read-only NetBird mode. Set to "true" on any instance that shares a NetBird tenant but
# must NOT change it - e.g. a dev box pointed at the production NetBird. It blocks EVERY
# write to the NetBird Management API (create/update/delete of networks, resources, routers,
# policies, groups, posture checks, Access Profiles) AND the automation scheduler + manual
# "Sync now". Reads (logs, browsing) are unaffected. App-only data (blocklist, grants,
# filter rules, default profiles, app config) stays editable. Leave unset/false in production.
NETBIRD_READONLY=false

# NetBird Management API (optional) - resolves user names/emails and the ROUTER
# column's peer name. NETBIRD_API_URL is your NetBird management URL
# (e.g. https://netbird.example.com); the app calls GET {URL}/api/users and
# GET {URL}/api/peers. NETBIRD_API_TOKEN is a NetBird PAT.
NETBIRD_API_URL=
NETBIRD_API_TOKEN=

# ─── SSO login (optional, Azure AD / Entra ID via OIDC) ───
# When all four below are set, every page requires login. Admins (NetBird
# owner/admin role) see everything; other users see only their own Activity logs.
# Azure App Registration redirect URI must be: {BASE_URL}/callback
# OIDC_ISSUER_BASE_URL = https://login.microsoftonline.com/<TENANT_ID>/v2.0
OIDC_ISSUER_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Public base URL of THIS app (no trailing slash), e.g. https://logs.example.com
BASE_URL=
# Random secret for the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# AD group (object id) whose members are admins, in addition to NetBird owner/admin.
# Requires the app to have Microsoft Graph application permission GroupMember.Read.All
# (admin-consented) so it can read users' group memberships.
ADMIN_GROUP_ID=

# Comma-separated emails allowed to SCAN + DELETE stored events that match the filters
# (Settings → Event Filtering → "Clean up already-stored garbage"). This is destructive and
# intentionally NOT granted to every admin. Empty + SSO on = nobody can purge.
# e.g. EVENT_PURGE_ADMINS=admin@example.com,ops@example.com
EVENT_PURGE_ADMINS=

# ─── Internal encrypted backup (optional) ───
# Folder where the internal FULL backup (all config + every secret, envelope-encrypted) is written
# on a schedule. Map it to persistent storage (a mounted volume) so backups survive container
# restarts. Defaults to /backup. The encryption PASSPHRASE is set in the app (Settings → Backup &
# Restore), NEVER in env: the server holds only the public key + the passphrase-encrypted private
# key, so it cannot decrypt its own backups - only the admin passphrase can. A forgotten passphrase
# means the backups are unreadable, by design.
BACKUP_DIR=/backup
