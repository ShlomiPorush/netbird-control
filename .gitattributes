# Shell scripts must keep LF line endings, or bash fails on Windows checkouts.
*.sh text eol=lf
# The systemd files are installed on a Linux host as they are.
netbird-docker-compose-files/exit-node-isolation/netbird-exit-isolation.conf text eol=lf
netbird-docker-compose-files/remote-access-isolation/netbird-control-gateway-isolation.service text eol=lf
# The remote browser image copies these files as they are; resolv.conf and ulogd.conf break with CRLF.
remote-browser/** text eol=lf
