{
    "name": "netbird-control",
    "version": "1.0.0",
    "description": "Webhook receiver and log viewer for NetBird network activity events",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "node --test",
        "web:dev": "npm --prefix ../frontend run dev",
        "web:build": "npm --prefix ../frontend run build",
        "docker:dev": "docker compose -f docker-compose-dev.yml up --build",
        "docker:dev:down": "docker compose -f docker-compose-dev.yml down",
        "docker:up": "docker compose up -d --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f app"
    },
    "keywords": [
        "netbird",
        "webhook",
        "logs",
        "network",
        "activity"
    ],
    "license": "MIT",
    "dependencies": {
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "express-openid-connect": "^3.4.0",
        "express-rate-limit": "^8.7.4",
        "nodemailer": "^10.5.0",
        "pg": "^8.23.1",
        "swagger-ui-express": "^5.0.1",
        "ws": "^8.22.2"
    },
    "devDependencies": {
        "nodemon": "^3.1.9"
    }
}
